# Environment configuration template
# Copy this file to .env.local and fill with real values.
# Never commit real secrets.

# Required: key for encrypting stored environment secrets (32-byte base64)
ENV_SECRETS_KEY=your-random-base64-encoded-key-here

# Required backend/runtime endpoints
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_KEHRNEL_AQL_ENDPOINT=http://localhost:8000

# Required onboarding mode
# external: deployment-wide allowlist-only onboarding
# internal: follow platform policy mode
ACCESS_MODE=external

# Default URLs shown/used in UI
NEXT_PUBLIC_DEFAULT_KEHRNEL_URL=http://localhost:8000
NEXT_PUBLIC_KEHRNEL_DOCS_URL=http://localhost:3001

# Required core DB connection
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/hdl_core?retryWrites=true&w=majority&compressors=zlib"
CORE_MONGODB_URL=${MONGODB_URI}
CORE_DATABASE_NAME=hdl_core

# Required auth settings
# In production this must be HTTPS (security:check enforces it)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Used for invite draft links (copy-paste email draft)
APP_BASE_URL=http://localhost:3000
# Optional extra trusted origins for mutating /api requests (comma-separated)
# CSRF_TRUSTED_ORIGINS=https://portal.example.com,https://admin.example.com
# Optional emergency switch (do not set in production)
ALLOW_INSECURE_HTTP=false

# ContextObjects AI assistant
# Set NEXT_PUBLIC_DISABLE_AI_ASSISTANT=false to show the Modeller AI Agent again.
# The assistant also expects a valid OPENAI_API_KEY on the server.
NEXT_PUBLIC_DISABLE_AI_ASSISTANT=false
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional local-only Demo Sherpa guide
# Production should leave this disabled unless the package is explicitly installed and enabled.
ENABLE_LOCAL_SHERPA=false
NEXT_PUBLIC_SHERPA_ENABLED=false
NEXT_PUBLIC_SHERPA_TITLE=Healthcare Data Lab Guide
NEXT_PUBLIC_SHERPA_STUDIO_TITLE=Healthcare Data Lab Guide Studio
NEXT_PUBLIC_SHERPA_CATALOG_API_URL=
NEXT_PUBLIC_SHERPA_PROJECT_SLUG=mongodb-industry-solutions
NEXT_PUBLIC_SHERPA_PROJECT_NAME=MongoDB Industry Solutions
NEXT_PUBLIC_SHERPA_DEMO_SLUG=healthcare-data-lab
NEXT_PUBLIC_SHERPA_DEMO_NAME=Healthcare Data Lab
NEXT_PUBLIC_SHERPA_DEMO_DESCRIPTION=Guided onboarding and reusable walkthroughs for the Healthcare Data Lab workspace.
NEXT_PUBLIC_SHERPA_PLAYER_LOGO_URL=/icon.svg
NEXT_PUBLIC_SHERPA_ASSISTANT_LOGO_URL=/icon.svg
NEXT_PUBLIC_SHERPA_DEFAULT_RIGHT=16
NEXT_PUBLIC_SHERPA_DEFAULT_TOP=16
# Optional host-owned AI endpoints. Leave blank to run browser-local mode or rely on the shared Sherpa API.
NEXT_PUBLIC_SHERPA_TTS_ENDPOINT=
NEXT_PUBLIC_SHERPA_TRANSCRIBE_ENDPOINT=
NEXT_PUBLIC_SHERPA_TRANSLATE_ENDPOINT=

# Optional Kehrnel auth header for server-side calls
KEHRNEL_API_KEY=

# Internal proxy is deny-by-default; set safe comma-separated prefixes only if needed
INTERNAL_PROXY_ALLOWED_PREFIXES=

# Security telemetry (for monitoring auth denials / 403 / 429 spikes)
# SECURITY_EVENTS_DISABLED=false
# SECURITY_EVENTS_TTL_DAYS=90

# Must stay false outside automated tests
TEST_MODE=false
